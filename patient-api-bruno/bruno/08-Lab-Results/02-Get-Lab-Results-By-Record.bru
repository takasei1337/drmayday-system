meta {
  name: 02. Xem kết quả xét nghiệm (Sheet GET /lab-results/:record_id)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/lab-results/{{recordId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("array");
    if (body.data.length > 0) {
      expect(Object.keys(body.data[0]).sort(), "data[0]").to.eql(["created_at","id","items","note","requested_by","status"]);
      expect(body.data[0].items).to.be.an("array");
      if (body.data[0].items.length > 0) {
        expect(Object.keys(body.data[0].items[0]).sort(), "items[0]").to.eql(["concluded_by","id","result_id","result_note","result_value","test_name"]);
      }
    }
  });
}
