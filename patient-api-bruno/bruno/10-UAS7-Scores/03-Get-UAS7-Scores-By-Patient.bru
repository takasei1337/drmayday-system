meta {
  name: 03. Lịch sử điểm UAS7 (Sheet GET /uas7-scores/patient/:patient_id)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/uas7-scores/patient/{{patientId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("array");
    if (body.data.length > 0) {
      expect(Object.keys(body.data[0]).sort(), "data[0]").to.eql(["daily_score","hss7","iss7","medical_record_id","note","patient_id","score_date"]);
    }
  });
}
