meta {
  name: 04. Tổng điểm tuần UAS7 (Sheet GET /uas7-scores/week/:patientId)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/uas7-scores/week/{{patientId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("object");
    expect(Object.keys(body.data).sort(), "data").to.eql(["completed_days","patient_id","severity_label","week_score"]);
  });
}
