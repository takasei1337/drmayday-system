meta {
  name: 03. Danh sách ảnh của user (Sheet GET /image-attachments/user/:user_id)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/image-attachments/user/{{patientId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("array");
    if (body.data.length > 0) {
      expect(Object.keys(body.data[0]).sort(), "data[0]").to.eql(["created_at","file_type","file_url","id","medical_record_id","question_id"]);
    }
  });
}
