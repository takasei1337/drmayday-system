meta {
  name: 02. Upload nhiều ảnh (Sheet POST /image-attachments/upload-multiple)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/image-attachments/upload-multiple
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

body:multipart-form {
  images: @file()
  user_id: {{patientId}}
  medical_record_id: {{recordId}}
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message","total"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("array");
    if (body.data.length > 0) {
      expect(Object.keys(body.data[0]).sort(), "data[0]").to.eql(["file_url","id"]);
    }
  });
}
