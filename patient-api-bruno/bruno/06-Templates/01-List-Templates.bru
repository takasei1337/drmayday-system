meta {
  name: 01. Danh sách mẫu phiếu (Sheet GET /templates/all)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/templates/all?page=1&limit=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("array");
    if (body.data.length > 0) {
      expect(Object.keys(body.data[0]).sort(), "data[0]").to.eql(["code_template","created_at","description","is_active","name","version"]);
    }
  });
}
