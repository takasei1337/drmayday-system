meta {
  name: 03. Đăng nhập Bác sĩ (Sheet 1.2 POST /auth/login)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{doctorUser}}",
    "password": "{{doctorPassword}}"
  }
}

script:pre-request {
  if (!bru.getEnvVar("doctorUser")) { bru.setEnvVar("doctorUser", "0901000002"); }
  if (!bru.getEnvVar("doctorPassword")) { bru.setEnvVar("doctorPassword", "Doctor@123"); }
}

script:post-response {
  const b = res.getBody();
  if (res.getStatus() === 200 && b && b.data && b.data.token) bru.setEnvVar("doctorToken", b.data.token);
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("object");
    expect(Object.keys(body.data).sort(), "data").to.eql(["token","user_info"]);
    expect(body.data.user_info).to.be.an("object");
    expect(Object.keys(body.data.user_info).sort(), "user_info").to.eql(["full_name","phone","role_id","user_id"]);
  });
}
