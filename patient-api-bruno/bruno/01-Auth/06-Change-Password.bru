meta {
  name: 06. Đổi mật khẩu (Sheet 1.5 PUT /auth/change-password)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "old_password": "{{testPatientPassword}}",
    "new_password": "{{testPatientPassword}}",
    "confirm_password": "{{testPatientPassword}}"
  }
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.eql({});
  });
}
