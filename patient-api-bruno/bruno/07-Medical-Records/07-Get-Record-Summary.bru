meta {
  name: 07. Tóm tắt hồ sơ bệnh án (Sheet GET /medical_records/:id/summary)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/medical_records/{{recordId}}/summary
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("object");
    expect(Object.keys(body.data).sort(), "data").to.eql(["created_at","medical_record_id","patient_name","status"]);
  });
}
