meta {
  name: 01. Lấy câu hỏi phân loại (Sheet GET /medical_records/classify-questions)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/medical_records/classify-questions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("array");
    if (body.data.length > 0) {
      expect(Object.keys(body.data[0]).sort(), "data[0]").to.eql(["options","question_id","question_text","type_question"]);
      expect(body.data[0].options).to.be.an("array");
      expect(Object.keys(body.data[0].options[0]).sort(), "options[0]").to.eql(["id","option_text","option_value"]);
    }
  });
}
