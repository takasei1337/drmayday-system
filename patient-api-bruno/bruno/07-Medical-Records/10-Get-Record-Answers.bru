meta {
  name: 10. Lấy câu trả lời bệnh án (Sheet GET /medical_records/:id/answers)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/medical_records/{{recordId}}/answers
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

script:post-response {
  const b = res.getBody();
  if (b && Array.isArray(b.data) && b.data[0] && b.data[0].id) bru.setEnvVar("answerId", String(b.data[0].id));
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("array");
    if (body.data.length > 0) {
      expect(Object.keys(body.data[0]).sort(), "data[0]").to.eql(["answer_text","answer_value","answered_by","created_at","id","medical_record_id","question_id","question_option_id","updated_at"]);
    }
  });
}
