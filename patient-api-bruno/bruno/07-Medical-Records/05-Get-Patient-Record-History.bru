meta {
  name: 05. Lịch sử bệnh án theo BN (Sheet GET /medical_records/patients/:id/history)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/medical_records/patients/{{patientId}}/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("array");
    if (body.data.length > 0) {
      expect(Object.keys(body.data[0]).sort(), "data[0]").to.eql(["created_at","instructions","medical_record_id","status"]);
    }
  });
}
