meta {
  name: 02. Gắn nhiều ảnh vào câu trả lời (Sheet POST /answer-images/bulk)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/answer-images/bulk
  body: json
  auth: bearer
}

auth:bearer {
  token: {{patientToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "answer_id": "{{answerId}}",
    "attachments": [
      {
        "attachment_id": "{{attachmentId}}"
      }
    ]
  }
}

tests {
  test("Chuẩn GoogleSheet: top-level keys & code 1000", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(Object.keys(body).sort(), "top-level").to.eql(["code","data","message","total"]);
    expect(body.code).to.equal(1000);
    expect(body.data).to.be.an("array");
    if (body.data.length > 0) {
      expect(Object.keys(body.data[0]).sort(), "data[0]").to.eql(["answer_id","attachment_id","id"]);
    }
  });
}
