meta {
  name: 08. Đổi mật khẩu (Sheet 1.5 change_password)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/change_password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "old_password": "{{adminPassword}}",
    "new_password": "{{adminPassword}}",
    "confirm_password": "{{adminPassword}}"
  }
}
