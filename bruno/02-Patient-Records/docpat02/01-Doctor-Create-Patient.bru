meta {
  name: docpat02. Bác sĩ tạo mới Bệnh nhân
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/doctor/patients/create
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{doctorToken}}
}

body:json {
  {
    "full_name": "Trần Thị Mai",
    "phone": "0987654321",
