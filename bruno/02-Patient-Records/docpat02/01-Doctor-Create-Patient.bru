    "gender": "female",
    "year_of_birth": 1996,
    "career": "Can bo cong chuc",
    "ethnic": "Kinh",
    "city_address": "Hà Nội",
    "commune_address": "Dịch Vọng",
    "hamlet_address": "Số 12 ngõ 45 Cầu Giấy",
    "health_insurance_number": "GD4010123456789",
    "next_of_kin_name": "Trần Văn Ba",
    "next_of_kin_phone": "0987111222"
  }
}

