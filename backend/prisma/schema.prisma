// ==============================================================================
// PRISMA SCHEMA CHO CSDL PHỤ (SUB DATABASE TRÊN SUPABASE)
// Quản lý các module mở rộng theo đúng yêu cầu Slide APIs mà CSDL chung không có
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUB_DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TestSubConnection {
  id       Int       @id @default(autoincrement())
  ghiChu   String    @map("ghi_chu")
  thoiDiem DateTime? @default(now()) @map("thoi_diem") @db.Timestamptz(6)

  @@map("test_sub_connection")
}

// ------------------------------------------------------------------------------
// 1. TOKEN BLACKLIST (Auth & Logout - Slide 2)
// ------------------------------------------------------------------------------
model TokenBlacklist {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  maTaiKhoan     BigInt?  @map("ma_tai_khoan")
  lyDoThuHoi     String?  @default("LOGOUT") @map("ly_do_thu_hoi")
  thoiDiemHetHan DateTime @map("thoi_diem_het_han")
  thoiDiemTao    DateTime @default(now()) @map("thoi_diem_tao")

  @@index([token])
  @@index([thoiDiemHetHan])
  @@map("token_blacklist")
}

// ------------------------------------------------------------------------------
// 2. KHOA / PHÒNG BAN CHUYÊN MÔN (Departments - Slide 4)
// (CSDL chung chỉ có chinhanh & phongkham, thiếu bảng departments theo Slide 4)
// ------------------------------------------------------------------------------
model Department {
  id             Int      @id @default(autoincrement())
  maChiNhanh     BigInt   @map("ma_chi_nhanh")      // Khóa logic trỏ tới chinhanh ở DB chính
  departmentCode String   @unique @map("department_code")
  departmentName String   @map("department_name")
  description    String?  @map("description")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

// ------------------------------------------------------------------------------
// 3. THÔNG BÁO ĐẨY & FCM DEVICE TOKENS (Push Notifications - Slide 10)
// ------------------------------------------------------------------------------
model DeviceToken {
  id         Int      @id @default(autoincrement())
  userId     BigInt   @map("user_id")              // ma_tai_khoan
  fcmToken   String   @unique @map("fcm_token")
  deviceType String?  @default("WEB") @map("device_type") // WEB, ANDROID, IOS
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("device_tokens")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  title     String   @map("title")
  body      String   @map("body")
  isRead    Boolean  @default(false) @map("is_read")
  type      String   @default("SYSTEM") @map("type") // APPOINTMENT, UAS7_REMINDER, PRESCRIPTION
  data      Json?    @map("data")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

// ------------------------------------------------------------------------------
// 4. BỘ TẠO MẪU PHIẾU KHÁM ĐỘNG (Dynamic Form Builder - Slide 11)
// ------------------------------------------------------------------------------
model Template {
  id           Int               @id @default(autoincrement())
  codeTemplate String            @unique @map("code_template") // Mã định danh duy nhất (VD: TMPL_MAYDAY_01)
  title        String            @map("title")
  description  String?           @map("description")
  isActive     Boolean           @default(true) @map("is_active")
  version      Int               @default(1) @map("version")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  sections     TemplateSection[]

  @@map("templates")
}

model TemplateSection {
  id          Int                @id @default(autoincrement())
  templateId  Int                @map("template_id")
  sectionName String             @map("section_name")
  orderIndex  Int                @default(0) @map("order_index")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  template    Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions   TemplateQuestion[]

  @@map("template_sections")
}

model TemplateQuestion {
  id               Int             @id @default(autoincrement())
  sectionId        Int             @map("section_id")
  questionCode     String?         @map("question_code")
  questionText     String          @map("question_text")
  questionType     String          @map("question_type") // TEXT, NUMBER, SELECT, MULTI_SELECT, RADIO, DATE
  options          Json?           @map("options")       // Mảng các lựa chọn nếu là SELECT/RADIO
  isRequired       Boolean         @default(false) @map("is_required")
  parentQuestionId Int?            @map("parent_question_id")
  showIfAnswer     String?         @map("show_if_answer")
  filledBy         String?         @default("both") @map("filled_by")
  orderIndex       Int             @default(0) @map("order_index")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  section          TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("template_questions")
}

// ------------------------------------------------------------------------------
// 5. MỞ RỘNG KHO ẢNH TỔN THƯƠNG & STORAGE (Lesion Media & Bucket - Slide 8 & 9)
// ------------------------------------------------------------------------------
model AnhTonThuongMoRong {
  id              Int      @id @default(autoincrement())
  maHoSo          BigInt   @map("ma_ho_so")
  maTaiKhoan      BigInt   @map("ma_tai_khoan")
  maTepDinhKemGoc BigInt?  @map("ma_tep_dinh_kem_goc")
  bucketName      String   @default("mayday-attachments") @map("bucket_name")
  storagePath     String   @map("storage_path")
  publicUrl       String   @map("public_url")
  dinhDangTep     String?  @map("dinh_dang_tep")
  dungLuongBytes  BigInt?  @map("dung_luong_bytes")
  questionId      String?  @map("question_id")
  mediaType       String?  @map("media_type")
  category        String?  @map("category")
  description     String?  @map("description")
  tenTepGoc       String?  @map("ten_tep_goc")
  toaDoX          Float?   @map("toa_do_x")
  toaDoY          Float?   @map("toa_do_y")
  vungCoThe       String?  @map("vung_co_the")
  ghiChuLamSang   String?  @map("ghi_chu_lam_sang")
  diemNguaNrs     Int?     @map("diem_ngua_nrs")
  diemDauNrs      Int?     @map("diem_dau_nrs")
  thoiDiemChup    DateTime @default(now()) @map("thoi_diem_chup")
  thoiDiemTao     DateTime @default(now()) @map("thoi_diem_tao")

  @@index([maHoSo])
  @@index([maTaiKhoan])
  @@map("anh_ton_thuong_mo_rong")
}

// ------------------------------------------------------------------------------
// 6. HỖ TRỢ DỮ LIỆU PHỤ TRỢ BỆNH NHÂN (Thay runtime_store.json -> Supabase Sub DB)
// ------------------------------------------------------------------------------
model PatientExtraProfile {
  maNguoi                 BigInt    @id @map("ma_nguoi")
  genderRaw               String?   @map("gender_raw") // Hỗ trợ 'other' ngoài ('Nam','Nu') của Main DB
  yearOfBirth             Int?      @map("year_of_birth")
  careerRaw               String?   @map("career_raw") // Giữ giá trị nghề nghiệp gốc người dùng nhập
  workPlace               String?   @map("work_place")
  firstVisit              DateTime? @map("first_visit")
  healthInsuranceValidate String?   @map("health_insurance_validate")
  medicalHistory          String?   @map("medical_history")
  allergyHistory          String?   @map("allergy_history")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("patient_extra_profiles")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  maTaiKhoan BigInt  @map("ma_tai_khoan")
  phone     String   @map("phone")
  otpCode   String   @map("otp_code")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("password_reset_tokens")
}

model MedicalRecordMeta {
  maHoSo            BigInt    @id @map("ma_ho_so")
  maBenhNhan        BigInt    @map("ma_benh_nhan")
  templateId        Int?      @map("template_id")
  recordSubtype     String?   @map("record_subtype") // URTICARIA_ACUTE | URTICARIA_CHRONIC_INIT | URTICARIA_FOLLOWUP
  screeningDecision String?   @map("screening_decision")
  lyDoDenKham       String?   @map("ly_do_den_kham")
  trieuChungChinh   String?   @map("trieu_chung_chinh")
  thoiGianKhoiPhat  String?   @map("thoi_gian_khoi_phat")
  doctorConclusion  String?   @map("doctor_conclusion")
  doctorNotes       String?   @map("doctor_notes")
  assignedDoctorId  BigInt?   @map("assigned_doctor_id")
  createdBy         BigInt?   @map("created_by")
  lockedAt          DateTime? @map("locked_at")
  closedAt          DateTime? @map("closed_at")
  closedBy          BigInt?   @map("closed_by")
  acceptedAt        DateTime? @map("accepted_at")
  acceptedBy        BigInt?   @map("accepted_by")
  completedAt       DateTime? @map("completed_at")
  completedBy       BigInt?   @map("completed_by")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([maBenhNhan])
  @@map("medical_record_meta")
}

model MedicalRecordAnswer {
  id               Int      @id @default(autoincrement())
  maHoSo           BigInt   @map("ma_ho_so")
  questionId       Int      @map("question_id")
  questionCode     String?  @map("question_code")
  questionOptionId Int?     @map("question_option_id")
  answerValue      String?  @map("answer_value")
  answerJson       Json?    @map("answer_json")
  answeredBy       BigInt?  @map("answered_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([maHoSo, questionId])
  @@index([maHoSo])
  @@map("medical_record_answers")
}

model AnswerImage {
  id           Int      @id @default(autoincrement())
  maHoSo       BigInt   @map("ma_ho_so")
  questionId   Int      @map("question_id")
  attachmentId BigInt   @map("attachment_id")
  optionValue  String?  @map("option_value")
  publicUrl    String?  @map("public_url")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([maHoSo, questionId, attachmentId])
  @@index([maHoSo, questionId])
  @@map("answer_images")
}

model Uas7Note {
  id                Int      @id @default(autoincrement())
  maBenhNhan        BigInt   @map("ma_benh_nhan")
  maHoSoMan         BigInt?  @map("ma_ho_so_man")
  scoreDate         String   @map("score_date") // YYYY-MM-DD
  whealScore        Int      @map("wheal_score")
  itchScore         Int      @map("itch_score")
  uasDaily          Int      @map("uas_daily")
  notes             String?  @map("notes")
  medicationChanged Boolean  @default(false) @map("medication_changed")
  medicationStatus  String?  @map("medication_status")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([maBenhNhan, scoreDate])
  @@map("uas7_notes")
}

model LesionEpisodeMeta {
  maDotTonThuong     BigInt    @id @map("ma_dot_ton_thuong")
  maHoSo             BigInt    @map("ma_ho_so")
  maBenhNhan         BigInt    @map("ma_benh_nhan")
  hasLesions         Boolean   @default(true) @map("has_lesions")
  triggerCategory    String?   @map("trigger_category")
  occurredAt         DateTime? @map("occurred_at")
  contextTags        String?   @map("context_tags")
  contextOther       String?   @map("context_other")
  medicationTakenAgo String?   @map("medication_taken_ago")
  medicationUnit     String?   @map("medication_unit")
  endedAt            DateTime? @map("ended_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([maHoSo])
  @@map("lesion_episode_meta")
}

model LesionLocationMeta {
  maViTriTonThuong   BigInt    @id @map("ma_vi_tri_ton_thuong")
  maDotTonThuong     BigInt    @map("ma_dot_ton_thuong")
  bodyPart           String    @map("body_part")
  lesionType         String?   @map("lesion_type")
  occurredAt         DateTime? @map("occurred_at")
  contextTags        String?   @map("context_tags")
  contextOther       String?   @map("context_other")
  medicationName     String?   @map("medication_name")
  medicationTakenAgo String?   @map("medication_taken_ago")
  medicationUnit     String?   @map("medication_unit")
  itchScoreNrs       Int?      @map("itch_score_nrs")
  painScoreNrs       Int?      @map("pain_score_nrs")
  notes              String?   @map("notes")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([maDotTonThuong])
  @@map("lesion_location_meta")
}

model LesionPhotoMeta {
  maAnh        BigInt   @id @map("ma_anh")
  annotatedUrl String?  @map("annotated_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("lesion_photo_meta")
}

model LabRequest {
  id          Int              @id @default(autoincrement())
  maHoSo      BigInt           @map("ma_ho_so")
  requestedBy BigInt           @map("requested_by")
  status      String           @default("pending") @map("status")
  note        String?          @map("note")
  createdAt   DateTime         @default(now()) @map("created_at")
  items       LabRequestItem[]

  @@index([maHoSo])
  @@map("lab_requests")
}

model LabRequestItem {
  id           Int        @id @default(autoincrement())
  labRequestId Int        @map("lab_request_id")
  testName     String     @map("test_name")
  description  String?    @map("description")
  resultId     Int?       @map("result_id")
  resultValue  String?    @map("result_value")
  concludedBy  BigInt?    @map("concluded_by")
  resultNote   String?    @map("result_note")
  labRequest   LabRequest @relation(fields: [labRequestId], references: [id], onDelete: Cascade)

  @@index([labRequestId])
  @@map("lab_request_items")
}
